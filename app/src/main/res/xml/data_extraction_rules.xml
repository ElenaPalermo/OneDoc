<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия и перенос на новое устройство (Android 12+); правила те же, что в backup_rules.xml:
     только настройки, без базы и копий вложений — их URI на другом устройстве недоступны. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_language.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_language.xml" />
    </device-transfer>
</data-extraction-rules>
