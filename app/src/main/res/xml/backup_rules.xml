<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup на Android 8–11 (на 12+ действует data_extraction_rules.xml).
     В копию идут только настройки: DataStore (чтение, библиотека) и выбранный язык (Android 8–12).
     База (библиотека, «Недавние», позиции, закладки) и копии вложений из filesDir/incoming
     не копируются: они ссылаются на content:// URI и SAF-разрешения, которые на новое устройство
     не переносятся, — восстановленные записи указывали бы на недоступные файлы. -->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="sharedpref" path="app_language.xml" />
</full-backup-content>
